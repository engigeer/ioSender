<UserControl x:Class="CNC.Controls.SpindleControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CNC.Controls"
             xmlns:gcode="clr-namespace:CNC.GCode;assembly=CNC.Core"
             xmlns:casp="using:CNC.Controls.SpindleControl"
             mc:Ignorable="d"
             x:Name="root"
             d:DesignHeight="155" d:DesignWidth="250">
    <UserControl.Resources>
        <local:LogicalNotConverter x:Key="LogicalNotConverter" />
        <local:BoolToVisibleConverter x:Key="IsVisibleConverter" />
    </UserControl.Resources>
    <Grid>
        <GroupBox x:Uid="grp_spindle" x:Name="grpSpindle" Header="Laser Status" HorizontalAlignment="Left" VerticalAlignment="Top" Height="155" Width="250">
            <Grid HorizontalAlignment="Left" Height="126" VerticalAlignment="Top" Width="240" Margin="0,0,-2,-3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="133*"/>
                    <ColumnDefinition Width="107*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Vertical" HorizontalAlignment="Right" Width="130">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="-14,2,0,0">
                        <Label x:Uid="lbl_rpm" x:Name="lblRPM" Content="Power [W]" HorizontalContentAlignment="Right" VerticalAlignment="Center" Height="25" Width="90"/>
                        <local:NumericTextBox x:Name="cvRPM" Value="{Binding Path=RPM, Mode=TwoWay}" IsEnabled="{Binding Path=IsJobRunning, Converter={StaticResource LogicalNotConverter}}" Format="####0" HorizontalAlignment="Left" Margin="2,0,0,0" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Grid.Row="0" Grid.RowSpan="1" HorizontalAlignment="Left" Orientation="Vertical" Margin="4,2,0,0" Visibility="{Binding Path=EmissionEnable, Converter={StaticResource IsVisibleConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <Label Content="EMISSION" HorizontalContentAlignment="Left" VerticalAlignment="Center" Height="25" Width="70" Foreground="Orange" FontWeight="Bold"/>
                        <Image HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,0" Source="Resources/StatusAnnotations_Warning_16xLG_color.png"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Grid.Row="1" Grid.RowSpan="2" HorizontalAlignment="Left" Orientation="Vertical" Margin="-5,0,0,0">
                    <StackPanel>
                        <local:LEDControl x:Uid="lbl_threshold" Grid.Row="0" Label="Laser Threshold" IsSet="{Binding Path=Threshold, Mode=OneWay}" HorizontalAlignment="Right" Margin="-4,-4,0,0" Height="20" Loaded="LEDControl_Loaded"/>
                        <local:LEDControl x:Uid="lbl_enabled" Grid.Row="1" Label="Laser Enabled" IsSet="{Binding Path=SpindleEnable, Mode=OneWay}" HorizontalAlignment="Right" Margin="-4,-2,0,0" Height="20"/>
                        <local:LEDControl x:Uid="lbl_error" Grid.Row="1" Label="Laser Error" IsSet="{Binding Path=ResetError, Mode=OneWay}" HorizontalAlignment="Right" Margin="-4,-2,0,0" Height="20"/>

                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="0" Grid.Row="1" Orientation="Vertical" Margin="20,0,0,0">
                    <local:ToggleControl x:Uid="lbl_shutter" x:Name="tswShutter" Tag="Shutter" Label ="Shutter" IsEnabled="{Binding Path=IsJobRunning, Converter={StaticResource LogicalNotConverter}}" IsChecked="{Binding Path=Shutter, Mode=OneWay}" HorizontalAlignment="Left" Height="22" Click="chkSpindle_Click"/>
                </StackPanel>
                <StackPanel Grid.Column="0" Grid.Row="2" Orientation="Vertical" Margin="20,0,0,0">
                    <local:ToggleControl x:Uid="lbl_pilot" x:Name="tswPilot" Tag="Pilot" Label ="Pilot" IsChecked="{Binding Path=Pilot, Mode=OneWay}" HorizontalAlignment="Left" Height="22" Click="chkSpindle_Click"/>
                </StackPanel>
                <local:OverrideControl x:Name="overrideControl" Value="{Binding Path=RPMOverride, Mode=OneWay}" CommandGenerated="override_CommandGenerated" Margin="0,0,0,2" Grid.Row="3" Grid.ColumnSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Right" EncoderMode="SpindleRPM">
                </local:OverrideControl>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
