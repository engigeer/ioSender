<UserControl x:Class="CNC.Controls.CoolantControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CNC.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="80" d:DesignWidth="250">
    <UserControl.Resources>
        <local:LogicalNotConverter x:Key="LogicalNotConverter" />
        <local:BoolToVisibleConverter x:Key="IsVisibleConverter" />
    </UserControl.Resources>
    <GroupBox x:Uid="grp_coolant" x:Name="grpCoolant" Header="Powder / Gas Control" HorizontalAlignment="Left" VerticalAlignment="Top" Width="250">
        <Grid HorizontalAlignment="Left" Height="Auto" Margin="-2,4,0,0" VerticalAlignment="Top" Width="242">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="45*"/>
                <ColumnDefinition Width="56*"/>
                <ColumnDefinition Width="36*"/>
                <ColumnDefinition Width="36*"/>
                <ColumnDefinition Width="42*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30*"/>
            </Grid.RowDefinitions>
            <local:ToggleControl x:Uid="lbl_fan" x:Name="tswMist" Tag="Mist" Grid.Row="0" Grid.ColumnSpan="4" Grid.Column="0" Label="Powder / Argon" IsChecked="{Binding Path=Mist, Mode=OneWay}" HorizontalAlignment="Left" Margin="20,0,0,0" VerticalAlignment="Top" Click="chkCoolant_Click"/>
            <local:ToggleControl x:Uid="lbl_flood" x:Name="tswFlood" Tag="Flood" Grid.Row="1" Grid.ColumnSpan="4" Grid.Column="0" Label="Nozzle Chiller" IsEnabled="{Binding Path=FloodEnable, Mode=OneWay}" IsChecked="{Binding Path=Flood, Mode=OneWay}" HorizontalAlignment="Left" Margin="20,0,0,0" VerticalAlignment="Top" Click="chkCoolant_Click"/>
            <RadioButton x:Uid="lbl_powsel1" x:Name="rbPowSel1" Grid.Row="0" Grid.ColumnSpan="1" Grid.Column="3" Content="1" IsEnabled="{Binding Path=IsJobRunning, Converter={StaticResource LogicalNotConverter}}" IsChecked="{Binding Path=Hopper1, Mode=TwoWay}" Margin="11,8,0,0" Click="rbPowSel_Click"/>
            <RadioButton x:Uid="lbl_powsel2" x:Name="rbPowSel2" Grid.Row="0" Grid.ColumnSpan="1" Grid.Column="4" Content="2" IsEnabled="{Binding Path=IsJobRunning, Converter={StaticResource LogicalNotConverter}}" IsChecked="{Binding Path=Hopper2, Mode=TwoWay}" Margin="11,8,0,0" Click="rbPowSel_Click"/>
            <Button x:Uid="btn_carset" Content="Gas Purge" IsEnabled="{Binding Path=Mist, Converter={StaticResource LogicalNotConverter}}" Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Width="70" Height="20" HorizontalAlignment="Left" Margin="10,3,0,0" VerticalAlignment="Top"/>
        </Grid>
    </GroupBox>
</UserControl>
